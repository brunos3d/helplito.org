# Loaded by `next build` and `next start` (NODE_ENV=production), including on Vercel.
# Public origin used for metadataBase, canonical and hreflang URLs, sitemap and robots.
NEXT_PUBLIC_SITE_URL=https://helplito.org

# Public source code repository. Enables the source code and research log links.
NEXT_PUBLIC_REPOSITORY_URL=https://github.com/brunos3d/helplito.org
