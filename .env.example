# Public origin of the site, without a trailing slash. Used for metadataBase, canonical
# and hreflang URLs, sitemap and robots. .env.production (committed) sets the production
# value; put http://localhost:3000 in .env.local for development.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Public source code repository, shown on the About and transparency pages once set.
# Leave empty to hide the link.
NEXT_PUBLIC_REPOSITORY_URL=https://github.com/brunos3d/helplito.org
