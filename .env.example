# Public origin of the site, without a trailing slash. Used for metadataBase, canonical
# and hreflang URLs, sitemap and robots. .env.production (committed) sets the production
# value; put http://localhost:3000 in .env.local for development.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# How the "Can You Help?" form delivers information.
# mailto (default): builds an email the sender reviews and sends from their own client.
# moderated: posts to /api/submissions, which forwards to SUBMISSION_WEBHOOK_URL.
NEXT_PUBLIC_SUBMISSION_MODE=mailto

# Required only in moderated mode. A private endpoint that receives JSON submissions.
SUBMISSION_WEBHOOK_URL=
SUBMISSION_WEBHOOK_TOKEN=

# Public source code repository, shown on the About and transparency pages once set.
# Leave empty to hide the link.
NEXT_PUBLIC_REPOSITORY_URL=https://github.com/brunos3d/helplito.org
